APP_ENV=development
# Generate distinct values: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SETUP_TOKEN=
# SQLite for local practice. Production requires MySQL/MariaDB.
DATABASE_URL=sqlite:///ponto.db
# DATABASE_URL=mysql+pymysql://USER:URL_ENCODED_PASSWORD@127.0.0.1:3306/DB?charset=utf8mb4
APPLICATION_ROOT=/
SESSION_COOKIE_SECURE=false
# Trust forwarded headers only after verifying the proxy configuration.
PROXY_FOR_COUNT=0
PROXY_PROTO_COUNT=0
PROXY_PREFIX_COUNT=0
